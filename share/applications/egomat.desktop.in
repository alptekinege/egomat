[Desktop Entry]
Type=Application
Version=1.0
Name=Egomat
GenericName=Image Converter and Optimizer
Comment=Convert and optimize images
Exec="@EGOMAT@" assistant
Icon=egomat
Terminal=false
StartupNotify=true
Categories=Graphics;2DGraphics;Utility;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/avif;image/bmp;image/tiff;image/svg+xml;image/x-icon;
Keywords=image;convert;optimize;optimise;compress;resize;webp;avif;png;jpeg;gif;pdf;
