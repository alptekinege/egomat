#!/usr/bin/env bash
# Generated by egomat's installer — do not edit; re-run `egomat install`.
# Shared wrapper for file managers that hand the selection over in an
# environment variable (Nautilus, Nemo, Caja) or as arguments (Thunar).
set -o pipefail

files=()

for v in NAUTILUS_SCRIPT_SELECTED_FILE_PATHS NEMO_SCRIPT_SELECTED_FILE_PATHS CAJA_SCRIPT_SELECTED_FILE_PATHS; do
  val=$(printenv "$v" 2>/dev/null) || val=""
  if [ -n "$val" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] && files+=("$line")
    done <<<"$val"
    break
  fi
done

if [ ${#files[@]} -eq 0 ] && [ $# -gt 0 ]; then
  files=("$@")
fi

if [ ${#files[@]} -eq 0 ]; then
  exec "@EGOMAT@" @ACTION@
fi

exec "@EGOMAT@" @ACTION@ "${files[@]}"
